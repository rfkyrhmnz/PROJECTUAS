"name":"Opacity","type":"OpacityCapability::OpacityBehavior"}]}],"layoutsFolderStructure":{"folderName":"__ROOT","children":[{"itemName":"Intro"},{"itemName":"About"},{"itemName":"Level Select"},{"itemName":"Gameplay1"},{"itemName":"Gameplay2"},{"itemName":"Gameplay3"},{"itemName":"Shop"},{"itemName":"Materi1"},{"itemName":"Materi2"},{"itemName":"Materi3"},{"itemName":"Outro"},{"itemName":"Loser"}]},"externalEvents":[],"externalEventsFolderStructure":{"folderName":"__ROOT"},"tests":[{"description":"Verify coin overlap and shooting","lastRunAt":1794968605839.0,"lastRunDurationMs":1126.0,"lastRunFramesExecuted":48,"lastRunStatus":"passed","name":"coin_shoot_check","type":"gameplay","source":["await harness.goToScene('Gameplay1');","await harness.stepFrames(30);","let mc = harness.getObjects('MC')[0];","let c = harness.getNearby('Coin','MC',5000)[0];","console.log('MC '+mc.x+','+mc.y+' w'+mc.width+' h'+mc.height+' coin '+c.x+','+c.y);","// place MC centered on coin","const tx = c.x + c.width/2 - mc.width/2;","const ty = c.y + c.height/2 - mc.height/2;","harness.setObjectPosition(mc.id, tx, ty);","await harness.stepFrames(5);","console.log('CoinsVar='+JSON.stringify(harness.getGlobalVariable('Coins'))+' coins left='+harness.getObjects('Coin').length);","harness.assert(harness.getGlobalVariable('Coins').value >= 5, 'coin collected when overlapping');","// shooting test","const ammoBefore = harness.getGlobalVariable('Ammo').value;","harness.setKeyPressed('j', true);","await harness.stepFrames(2);","harness.setKeyPressed('j', false);","await harness.stepFrames(10);","const ammoAfter = harness.getGlobalVariable('Ammo').value;","console.log('ammo '+ammoBefore+'->'+ammoAfter+' bullets='+harness.getObjects('Bullet').length);","harness.assert(ammoAfter === ammoBefore - 1, 'ammo decreased by shooting');"]},{"description":"Verify ButtonShop_Kiri buys Nyawa and Kanan buys Ammo","lastRunAt":1794943028117.0,"lastRunDurationMs":1764.0,"lastRunFramesExecuted":20,"lastRunStatus":"failed","name":"shop_buy_check","type":"gameplay","source":["await harness.goToScene('Gameplay1');","await harness.stepFrames(10);","// setup: give coins, reduce lives so lives purchase is valid","harness.setSceneVariable('Coins', 30);","harness.setSceneVariable('Lives', 1);","harness.setSceneVariable('Ammo', 10);","await harness.stepFrames(2);","// open shop with E","harness.setKeyPressed('e', true);","await harness.stepFrames(2);","harness.setKeyPressed('e', false);","await harness.stepFrames(5);","let state = harness.getSceneVariable('State');","harness.assert(state && state.value === 'main', 'E opens shop, State=main, got ' + JSON.stringify(state));","// click ButtonShop_Kiri (buy Nyawa path)","async function clickObj(name) {","  const objs = harness.getObjects(name);","  if (!objs.length) { harness.fail('object not found: ' + name); return false; }","  const o = objs[0];","  const cx = o.centerX, cy = o.centerY;","  harness.setMousePosition(cx, cy, o.layer);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(true);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(false);","  await harness.stepFrames(5);","  return true;","}","await clickObj('ButtonShop_Kiri');","state = harness.getSceneVariable('State');","let choice = harness.getSceneVariable('ShopChoice');","harness.assert(state && state.value === 'buy', 'ButtonShop_Kiri -> State=buy, got ' + JSON.stringify(state));","harness.assert(choice && choice.value === 'lives', 'ButtonShop_Kiri sets ShopChoice=lives, got ' + JSON.stringify(choice));","// wait buydelay 0.5s","await harness.stepFrames(40);","await clickObj('ButtonShop2Kiri');","await harness.stepFrames(5);","let lives = harness.getSceneVariable('Lives');","let coins = harness.getSceneVariable('Coins');","state = harness.getSceneVariable('State');","harness.assert(lives && lives.value === 2, 'Nyawa bertambah 1 -> Lives=2, got ' + JSON.stringify(lives));","harness.assert(coins && coins.value === 15, 'Coins berkurang 15 -> 15, got ' + JSON.stringify(coins));","harness.assert(state && state.value === 'success', 'purchase success State=success, got ' + JSON.stringify(state));","// wait 3 detik -> kembali play","await harness.stepFrames(200);","state = harness.getSceneVariable('State');","harness.assert(state && state.value === 'play', 'setelah 3 detik kembali play, got ' + JSON.stringify(state));","// --- test ammo path ---","harness.setSceneVariable('Coins', 30);","await harness.stepFrames(2);","harness.setKeyPressed('e', true);","await harness.stepFrames(2);","harness.setKeyPressed('e', false);","await harness.stepFrames(5);","await clickObj('ButtonShop_Kanan');","choice = harness.getSceneVariable('ShopChoice');","harness.assert(choice && choice.value === 'ammo', 'ButtonShop_Kanan sets ShopChoice=ammo, got ' + JSON.stringify(choice));","await harness.stepFrames(40);","await clickObj('ButtonShop2Kiri');","await harness.stepFrames(5);","let ammo = harness.getSceneVariable('Ammo');","coins = harness.getSceneVariable('Coins');","harness.assert(ammo && ammo.value === 20, 'Ammo bertambah 10 -> 20, got ' + JSON.stringify(ammo));","harness.assert(coins && coins.value === 10, 'Coins 30-20=10, got ' + JSON.stringify(coins));",""]},{"description":"Verify exact 15 coins now succeeds","lastRunAt":1794128640111.0,"lastRunDurationMs":525.0,"lastRunFramesExecuted":83,"lastRunStatus":"passed","name":"shop_exact15_check","type":"gameplay","source":["await harness.goToScene('Gameplay1');","await harness.stepFrames(10);","async function clickObj(name) {","  const objs = harness.getObjects(name);","  if (!objs.length) { harness.fail('object not found: ' + name); return; }","  const o = objs[0];","  harness.setMousePosition(o.centerX, o.centerY, o.layer);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(true);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(false);","  await harness.stepFrames(5);","}","// Bug case: Coins pas 15, Lives penuh 3 -> harus success sekarang","harness.setSceneVariable('Coins', 15);","harness.setSceneVariable('Lives', 3);","harness.setObjectVariable(harness.getObjects('MC')[0].id, 'HP', 150);","await harness.stepFrames(2);","harness.setKeyPressed('e', true);","await harness.stepFrames(2);","harness.setKeyPressed('e', false);","await harness.stepFrames(5);","await clickObj('ButtonShop_Kiri');","await harness.stepFrames(40);","await clickObj('ButtonShop2Kiri');","await harness.stepFrames(5);","let st = harness.getSceneVariable('State');","let coins = harness.getSceneVariable('Coins');","let lives = harness.getSceneVariable('Lives');","harness.assert(st.value === 'success', 'Coins pas 15 harus success (Shop3), got ' + st.value);","harness.assert(coins.value === 0, 'Coins 15-15=0, got ' + coins.value);","harness.assert(lives.value === 3, 'Lives tetap max 3, got ' + lives.value);",""]},{"description":"Verify ammo path buttons work after fix","lastRunAt":1794128905266.0,"lastRunDurationMs":839.0,"lastRunFramesExecuted":555,"lastRunStatus":"passed","name":"shop_ammo_check","type":"gameplay","source":["await harness.goToScene('Gameplay1');","await harness.stepFrames(10);","async function clickObj(name) {","  const objs = harness.getObjects(name);","  if (!objs.length) { harness.fail('object not found: ' + name); return; }","  const o = objs[0];","  harness.setMousePosition(o.centerX, o.centerY, o.layer);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(true);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(false);","  await harness.stepFrames(5);","}","// Path kanan (ammo) cukup coin -> Shop3","harness.setSceneVariable('Coins', 30);","harness.setSceneVariable('Ammo', 10);","await harness.stepFrames(2);","harness.setKeyPressed('e', true);","await harness.stepFrames(2);","harness.setKeyPressed('e', false);","await harness.stepFrames(5);","await clickObj('ButtonShop_Kanan');","await harness.stepFrames(40);","await clickObj('ButtonShop2Kiri');","await harness.stepFrames(5);","let st = harness.getSceneVariable('State');","let ammo = harness.getSceneVariable('Ammo');","harness.assert(st.value === 'success', 'Ammo cukup harus success, got ' + st.value);","harness.assert(ammo.value === 20, 'Ammo 10->20, got ' + ammo.value);","await harness.stepFrames(200);","// Path kanan kurang coin -> Shop4"," harness.setSceneVariable('Coins', 5);"," harness.setSceneVariable('Ammo', 10);"," await harness.stepFrames(2);"," harness.setKeyPressed('e', true);"," await harness.stepFrames(2);"," harness.setKeyPressed('e', false);"," await harness.stepFrames(5);"," await clickObj('ButtonShop_Kanan');"," await harness.stepFrames(40);"," await clickObj('ButtonShop2Kiri');"," await harness.stepFrames(5);"," st = harness.getSceneVariable('State');"," harness.assert(st.value === 'fail', 'Ammo kurang harus fail (Shop4), got ' + st.value);"," await harness.stepFrames(200);"," st = harness.getSceneVariable('State');"," harness.assert(st.value === 'play', 'Setelah Shop4 3 detik kembali play, got ' + st.value);",""]},{"description":"Verify Intro and About navigation","lastRunAt":1794130307846.0,"lastRunDurationMs":520.0,"lastRunFramesExecuted":63,"lastRunStatus":"failed","name":"intro_about_check","type":"gameplay","source":["await harness.goToScene('Intro');","await harness.stepFrames(10);","async function clickObj(name) {","  const objs = harness.getObjects(name);","  if (!objs.length) { harness.fail('object not found: ' + name); return; }","  const o = objs[0];","  harness.setMousePosition(o.centerX, o.centerY, o.layer);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(true);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(false);","  await harness.stepFrames(5);","}","await clickObj('About');","await harness.stepFrames(10);","harness.assert(harness.getSceneName() === 'About', 'About button -> About scene, got ' + harness.getSceneName());","await harness.stepFrames(5);","await clickObj('ButtonAbout1');","await harness.stepFrames(5);","harness.assert(harness.getSceneName() === 'About', 'still in About after ButtonAbout1, got ' + harness.getSceneName());","let a2 = harness.getObjects('About2')[0];","let a1 = harness.getObjects('About1')[0];","harness.assert(a2 && !a2.hidden, 'ButtonAbout1 shows About2');","harness.assert(a1 && a1.hidden, 'About1 hidden after next');","await clickObj('Button2Next');","await harness.stepFrames(5);","let a3 = harness.getObjects('About3')[0];","harness.assert(a3 && !a3.hidden, 'Button2Next shows About3');","await clickObj('ButtonAbout3Kanan');","await harness.stepFrames(5);","let a4 = harness.getObjects('About4')[0];","harness.assert(a4 && !a4.hidden, 'ButtonAbout3Kanan shows About4');","await clickObj('ButtonMainMenu');","await harness.stepFrames(10);","harness.assert(harness.getSceneName() === 'Intro', 'ButtonMainMenu -> Intro, got ' + harness.getSceneName());","await clickObj('StartGame');","await harness.stepFrames(10);","harness.assert(harness.getSceneName() === 'Gameplay1', 'StartGame -> Gameplay1, got ' + harness.getSceneName());",""]},{"description":"Verify About paging with cooldown","lastRunAt":1794130372920.0,"lastRunDurationMs":907.0,"lastRunFramesExecuted":181,"lastRunStatus":"passed","name":"about_debug","type":"gameplay","source":["await harness.goToScene('About');","await harness.stepFrames(30);","async function clickObj(name) {","  const o = harness.getObjects(name)[0];","  harness.setMousePosition(o.centerX, o.centerY, o.layer);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(true);","  await harness.stepFrames(3);","  harness.setMouseButtonPressed(false);","  await harness.stepFrames(30);","}","await clickObj('ButtonAbout1');","let a2 = harness.getObjects('About2')[0];","harness.assert(a2 && !a2.hidden, 'About1->About2 ok');","await clickObj('Button2Next');","let a3 = harness.getObjects('About3')[0];","let a4 = harness.getObjects('About4')[0];","harness.assert(a3 && !a3.hidden, 'About2->About3 ok');","harness.assert(a4 && a4.hidden, 'About4 masih hidden (tidak loncat)');","await clickObj('ButtonAbout3Kanan');","a4 = harness.getObjects('About4')[0];","harness.assert(a4 && !a4.hidden, 'About3->About4 ok');","await clickObj('ButtonMainMenu');","await harness.stepFrames(10);","harness.assert(harness.getSceneName() === 'Intro', 'MainMenu->Intro, got ' + harness.getSceneName());",""]},{"description":"Verify fixed button mapping","lastRunAt":1794309776796.0,"lastRunDurationMs":1507.0,"lastRunFramesExecuted":228,"lastRunStatus":"passed","name":"intro_nav_check","type":"gameplay","source":["await harness.goToScene('Intro');","await harness.stepFrames(10);","async function clickObj(name) {","  const objs = harness.getObjects(name);","  if (!objs.length) { harness.fail('object not found: ' + name); return; }","  const o = objs[0];","  console.log('click ' + name + ' hidden=' + o.hidden + ' cx=' + Math.round(o.centerX) + ' cy=' + Math.round(o.centerY) + ' w=' + Math.round(o.width) + ' h=' + Math.round(o.height));","  harness.setMousePosition(o.centerX, o.centerY, o.layer);","  await harness.stepFrames(2);","  harness.setMouseButtonPressed(true);","  await harness.stepFrames(3);","  harness.setMouseButtonPressed(false);","  await harness.stepFrames(10);","}","await clickObj('StartGame');","await harness.stepFrames(10);","harness.assert(harness.getSceneName() === 'Gameplay1', 'StartGame -> Gameplay1, got ' + harness.getSceneName());","await harness.goToScene('Intro');","await harness.stepFrames(10);","await clickObj('LevelSelect');","await harness.stepFrames(10);","harness.assert(harness.getSceneName() === 'Level Select', 'LevelSelect -> Level Select, got ' + harness.getSceneName());","await harness.goToScene('Intro');","await harness.stepFrames(10);","await clickObj('About');","await harness.stepFrames(10);","harness.assert(harness.getSceneName() === 'About', 'About btn -> About, got ' + harness.getSceneName());","await harness.stepFrames(20);","await clickObj('ButtonAbout1');","await harness.stepFrames(10);","let a2 = harness.getObjects('About2')[0];","harness.assert(a2 && !a2.hidden, 'About1->About2 ok');","await clickObj('Button2Next');","await harness.stepFrames(10);","let a3 = harness.getObjects('About3')[0];","harness.assert(a3 && !a3.hidden, 'About2->About3 ok');","await clickObj('ButtonAbout3Kanan');","await harness.stepFrames(10);","let a4 = harness.getObjects('About4')[0];","harness.assert(a4 && !a4.hidden, 'About3->About4 ok');","await clickObj('ButtonMainMenu');","await harness.stepFrames(10);","harness.assert(harness.getSceneName() === 'Intro', 'MainMenu -> Intro, got ' + harness.getSceneName());",""]},{"description":"Verify hover, click and shoot sounds play","lastRunAt":1794951069068.0,"lastRunDurationMs":1139.0,"lastRunFramesExecuted":102,"lastRunStatus":"passed","name":"audio_check","type":"gameplay","source":["await harness.goToScene('Intro');","await harness.stepFrames(30);","// hover StartGame","const btns = harness.getObjects('StartGame');","harness.assert(btns.length>0, 'StartGame exists');","if (btns.length>0) {","  harness.setMousePosition(btns[0].centerX, btns[0].centerY);","  await harness.stepFrames(10);","}","let sounds = harness.getPlayedSounds().map(s=>s.sound);","harness.assert(sounds.some(s=>s.includes('Data_Point')), 'Hover sound played, got: '+sounds.join(','));","await harness.stepFrames(5);","// click StartGame via mouse on button - simulate click using touch? ButtonFSM uses click, try mouse press","const b = harness.getObjects('StartGame')[0];","harness.setMousePosition(b.centerX, b.centerY);","harness.setMouseButtonPressed(true,'left');","await harness.stepFrames(3);","harness.setMouseButtonPressed(false,'left');","await harness.stepFrames(10);","sounds = harness.getPlayedSounds().map(s=>s.sound);","harness.assert(sounds.some(s=>s.includes('Click')), 'Click sound played, got: '+sounds.join(','));","// go gameplay and test shoot sound","await harness.goToScene('Gameplay1');","await harness.stepFrames(30);","harness.setKeyPressed('j', true);","await harness.stepFrames(2);","harness.setKeyPressed('j', false);","await harness.stepFrames(10);","sounds = harness.getPlayedSounds().map(s=>s.sound);","harness.assert(sounds.some(s=>s.includes('Laser')), 'Shoot sound played, got: '+sounds.join(','));",""]}],"testsFolderStructure":{"folderName":"__ROOT","children":[{"itemName":"coin_shoot_check"},{"itemName":"shop_buy_check"},{"itemName":"shop_exact15_check"},{"itemName":"shop_ammo_check"},{"itemName":"intro_about_check"},{"itemName":"about_debug"},{"itemName":"intro_nav_check"},{"itemName":"audio_check"}]},"eventsFunctionsExtensions":[{"author":"","category":"User interface","dimension":"2D","extensionNamespace":"","fullName":"Resource bar (separated units)","gdevelopVersion":">=5.5.230","helpPath":"/objects/resource-bar","iconUrl":"data:image/svg+xml;base64,","name":"TiledUnitsBar","previewIconUrl":"https://asset-resources.gdevelop.io/public-resources/Icons/063e9152cf65bc0f3be2a828afd950c3ecf1b1fc72feefdc2467252fe987dc0f_dots-horizontal.svg","shortDescription":"A bar that represents a resource in the game (health, mana, ammo, etc).","version":"2.0.2","description":["A bar that represents a resource in the game (health, mana, ammo, etc).","","There are ready-to-use resource bars in the asset-store [resource bars pack](https://editor.gdevelop.io/?initial-dialog=asset-store&asset-pack=resource-bars-resource-bars)."],"origin":{"identifier":"TiledUnitsBar","name":"gdevelop-extension-store"},"tags":["resource","bar","health","mana","shield","hearts","lives","ammo"],"authorIds":["IWykYNRvhCZBN3vEgKEbBPOR3Oc2","gqDaZjCfevOOxBYkK6zlhtZnXCg1","q8ubdigLvIRXLxsJDDTaokO41mc2"],"changelog":[{"version":"2.0.0","breaking":"- Resource bars now use \"variants\", allowing easy swapping of their visual aspect. You will have to make some adjustments to existing resource bars in your project. Follow this [migration documentation](https://wiki.gdevelop.io/gdevelop5/objects/custom-objects-prefab-template/migrate-to-variants/) to