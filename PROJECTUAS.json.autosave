behaviorsSharedData":[]}],"layoutsFolderStructure":{"folderName":"__ROOT","children":[{"itemName":"Intro"},{"itemName":"Gameplay1"},{"itemName":"Question"},{"itemName":"Outro"}]},"externalEvents":[],"externalEventsFolderStructure":{"folderName":"__ROOT"},"tests":[{"description":"Verify coin overlap and shooting","lastRunAt":1794022736569.0,"lastRunDurationMs":1257.0,"lastRunFramesExecuted":48,"lastRunStatus":"passed","name":"coin_shoot_check","type":"gameplay","source":["await harness.goToScene('Gameplay1');","await harness.stepFrames(30);","let mc = harness.getObjects('MC')[0];","let c = harness.getNearby('Coin','MC',5000)[0];","console.log('MC '+mc.x+','+mc.y+' w'+mc.width+' h'+mc.height+' coin '+c.x+','+c.y);","// place MC centered on coin","const tx = c.x + c.width/2 - mc.width/2;","const ty = c.y + c.height/2 - mc.height/2;","harness.setObjectPosition(mc.id, tx, ty);","await harness.stepFrames(5);","console.log('CoinsVar='+JSON.stringify(harness.getSceneVariable('Coins'))+' coins left='+harness.getObjects('Coin').length);","harness.assert(harness.getSceneVariable('Coins').value >= 5, 'coin collected when overlapping');","// shooting test","const ammoBefore = harness.getSceneVariable('Ammo').value;","harness.setKeyPressed('j', true);","await harness.stepFrames(2);","harness.setKeyPressed('j', false);","await harness.stepFrames(10);","const ammoAfter = harness.getSceneVariable('Ammo').value;","console.log('ammo '+ammoBefore+'->'+ammoAfter+' bullets='+harness.getObjects('Bullet').length);","harness.assert(ammoAfter === ammoBefore - 1, 'ammo decreased by shooting');"]}],"testsFolderStructure":{"folderName":"__ROOT","children":[{"itemName":"coin_shoot_check"}]},"eventsFunctionsExtensions":[{"author":"","category":"User interface","dimension":"2D","extensionNamespace":"","fullName":"Resource bar (separated units)","gdevelopVersion":">=5.5.230","helpPath":"/objects/resource-bar","iconUrl":"data:image/svg+xml;base64,","name":"TiledUnitsBar","previewIconUrl":"https://as